# PostgreSQL Connection (pooled for queries)
# Use the pooled endpoint from your database provider (e.g., Neon's pooling endpoint)
DATABASE_URL="postgresql://<username>:<password>@<pooled-host>/neondb?sslmode=require&connection_limit=10&pool_timeout=30&connect_timeout=10"

# PostgreSQL Connection (unpooled for migrations)
# Use the direct/unpooled endpoint from your database provider
DATABASE_URL_UNPOOLED="postgresql://<username>:<password>@<direct-host>/neondb?sslmode=require"

# Session cookie signing (required in production). Long random string, e.g. `openssl rand -hex 32`.
# Rotating it signs every dashboard/admin user out.
SESSION_SECRET="<random-secret>"

# Admin Access (optional)
# Get this value by logging in with your admin wallet and copying the xpub from your dashboard
ADMIN_XPUB="xpub_<your_admin_wallet_xpub>"

# Base URL for embed script (optional)
# Auto-detected if not set, but can be explicitly configured
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Login token signing (required in production; ephemeral keys are used in development only)
# Generate an ES256 (P-256) private key in PKCS8 PEM format:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Store it in your secret manager; newlines may be written as \n
KEYREX_JWT_PRIVATE_KEY="<pkcs8-pem-private-key>"
# Secret (>= 32 chars) used for per-site pairwise user IDs, e.g.: openssl rand -hex 32
# Changing it changes every user's per-site ID, so treat it as permanent
KEYREX_PAIRWISE_SECRET="<random-secret-at-least-32-chars>"
# Optional: retired public keys kept published during key rotation (JSON JWKS, public keys only)
# KEYREX_JWT_PREVIOUS_JWKS='{"keys":[]}'
# Optional: set to "false" to stop sending the legacy identifier (legacy_sub claim) after migration
# KEYREX_INCLUDE_LEGACY_SUB="true"
# Optional: set to "false" to stop returning the raw identifier to embedding sites; the
# `xpub`/`identifier` field then carries a per-site opaque value instead (do this after the sunset)
# KEYREX_LEGACY_XPUB_DELIVERY="true"
# Optional: ISO date advertised in the Sunset header and the dashboard banner
# KEYREX_LEGACY_SUNSET="2027-01-31"

# Optional: private login mode (per-site login domain, LNURL-auth per-site keys)
# CNAME target customers point their login subdomain at (e.g. the value shown in your hosting provider)
# KEYREX_LOGIN_CNAME_TARGET="<your-cname-target>"
# Comma-separated hosts that serve the full app; every other host may only serve /api/auth/callback
# KEYREX_PRIMARY_HOSTS="keyrex.co,www.keyrex.co"
# Optional: auto-attach customer login domains to the Vercel project
# VERCEL_API_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""

# Environment (optional)
# Set to "production" for secure cookies and security headers
NODE_ENV="development"

# ⚠️ SECURITY WARNING ⚠️
# NEVER commit this file with real credentials to git
# Always keep .env.local in .gitignore for local development
# Use Vercel dashboard to set production environment variables
