# PostgreSQL Connection (pooled for queries)
# Use the pooled endpoint from your database provider (e.g., Neon's pooling endpoint)
DATABASE_URL="postgresql://<username>:<password>@<pooled-host>/neondb?sslmode=require&connection_limit=10&pool_timeout=30&connect_timeout=10"

# PostgreSQL Connection (unpooled for migrations)
# Use the direct/unpooled endpoint from your database provider
DATABASE_URL_UNPOOLED="postgresql://<username>:<password>@<direct-host>/neondb?sslmode=require"

# Admin Access (optional)
# Get this value by logging in with your admin wallet and copying the xpub from your dashboard
ADMIN_XPUB="xpub_<your_admin_wallet_xpub>"

# Base URL for embed script (optional)
# Auto-detected if not set, but can be explicitly configured
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Environment (optional)
# Set to "production" for secure cookies and security headers
NODE_ENV="development"

# ⚠️ SECURITY WARNING ⚠️
# NEVER commit this file with real credentials to git
# Always keep .env.local in .gitignore for local development
# Use Vercel dashboard to set production environment variables
