<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>NeuralAPI - Premium AI APIs for Developers</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      :root {
        --primary: #6366f1;
        --primary-dark: #4f46e5;
        --secondary: #8b5cf6;
        --accent: #f59e0b;
        --success: #10b981;
        --bg-main: #0f172a;
        --bg-card: #1e293b;
        --text-main: #f1f5f9;
        --text-muted: #94a3b8;
        --border: #334155;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: var(--text-main);
        line-height: 1.6;
      }

      /* Header */
      header {
        padding: 1.25rem 2rem;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header-content {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
        color: white;
        text-decoration: none;
      }

      .logo-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      nav a:hover {
        color: var(--text-main);
      }

      main {
        flex: 1;
        padding: 2.5rem 1.5rem 3rem;
        display: flex;
        justify-content: center;
      }

      .layout {
        max-width: 1100px;
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.4fr);
        gap: 2.5rem;
        align-items: flex-start;
      }

      @media (max-width: 900px) {
        .layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      .content-card {
        background: var(--card-bg);
        border-radius: 1.25rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
        padding: 1.75rem 1.75rem 2rem;
        border: 1px solid rgba(15, 23, 42, 0.04);
      }

      .content-card h1 {
        font-size: clamp(1.9rem, 2.3vw, 2.2rem);
        margin: 0 0 0.75rem;
      }

      .content-card p.lead {
        margin: 0 0 1.5rem;
        color: var(--text-sub);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(249, 115, 22, 0.07);
        color: #9a3412;
        border-radius: 999px;
        padding: 0.3rem 0.8rem;
        font-size: 0.75rem;
        margin-bottom: 0.75rem;
        border: 1px solid rgba(249, 115, 22, 0.18);
      }

      .pill-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: #f97316;
      }

      .feature-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.85rem;
        margin-top: 1.25rem;
      }

      .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.9rem;
        color: var(--text-sub);
      }

      .feature-item strong {
        color: #111827;
      }

      .feature-bullet {
        width: 18px;
        height: 18px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #059669;
        font-size: 0.8rem;
        flex-shrink: 0;
      }

      .side-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .side-panel h2 {
        margin: 0;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #6b7280;
      }

      .helper-text {
        font-size: 0.85rem;
        color: #6b7280;
        line-height: 1.5;
      }

      .keyrex-wrapper {
        margin-top: 0.75rem;
      }

      footer {
        padding: 1rem 1.5rem 1.5rem;
        font-size: 0.8rem;
        color: #6b7280;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">ACME LEARNING</div>
      <nav aria-label="Fake client navigation">
        <a href="#">Courses</a>
        <a href="#">Pricing</a>
        <a href="#">Sign in</a>
      </nav>
    </header>

    <main>
      <div class="layout">
        <section class="content-card">
          <div class="pill">
            <span class="pill-dot"></span>
            Example client website
          </div>
          <h1>Members‑only dashboard</h1>
          <p class="lead">
            This is a <strong>fake customer site</strong> used only to test the Key-Rex
            sign‑in experience from an end‑user’s perspective. Nothing here is real
            content or production data.
          </p>
          <div class="feature-list">
            <div class="feature-item">
              <div class="feature-bullet">1</div>
              <div>
                <strong>Click the Key-Rex button on the right</strong> to start the
                Lightning wallet sign‑in.
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-bullet">2</div>
              <div>
                Walk through the <strong>full LNURL‑auth flow</strong> as if you were a
                visitor logging in to this site.
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-bullet">3</div>
              <div>
                After authentication, you can wire this into whatever
                <strong>“dashboard”</strong> experience you’d like to simulate.
              </div>
            </div>
          </div>
        </section>

        <aside class="side-panel">
          <div>
            <h2>Sign in with Key-Rex</h2>
            <p class="helper-text">
              The card below is the real Key-Rex embed, exactly as it would appear on a
              customer’s website. Use this page to test all wallet and device scenarios.
            </p>
          </div>

          <div class="keyrex-wrapper">
            <!-- Key-Rex embed target -->
            <div id="keyrex-container"></div>
          </div>
        </aside>
      </div>
    </main>

    <footer>
      This page exists only for local testing. It is not part of the public Key-Rex
      product or documentation.
    </footer>

    <!-- Key-Rex Integration Code -->
    <!-- Note: Fake client site runs on port 3001, Key-Rex server on port 3000 -->
    <!-- This creates your user record so the siteId exists in storage -->
    <script src="http://localhost:3000/embed?siteId=a252dfa1030706a49efab31af2fc29d6&v=2"></script>
    <!-- Key-Rex auto-initializes when the script loads, but we also have a manual fallback -->
    <script>
      // Aggressive container check - check multiple times
      function checkAndInit() {
        const container = document.getElementById('keyrex-container');
        console.log('Key-Rex: Container check - Found:', !!container, 'Children:', container ? container.children.length : 0, 'KeyRex exists:', typeof window.KeyRex !== 'undefined');
        
        if (window.KeyRex && window.KeyRex.init) {
          if (!container) {
            console.error('Key-Rex: Container not found!');
            return;
          }
          
          if (container.children.length === 0) {
            console.log('Key-Rex: Card missing, attempting manual init...');
            try {
              window.KeyRex.init();
            } catch (e) {
              console.error('Key-Rex: Error in manual init:', e);
            }
          } else {
            console.log('Key-Rex: Card found with', container.children.length, 'children');
          }
        }
      }
      
      // Check immediately, then at intervals
      checkAndInit();
      setTimeout(checkAndInit, 1000);
      setTimeout(checkAndInit, 2000);
      setTimeout(checkAndInit, 3000);
      setTimeout(checkAndInit, 5000);
      
      // Also check when DOM is fully ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkAndInit);
      }
      
      // Set up success and error callbacks
      function setupKeyRexCallbacks() {
        if (window.KeyRex) {
          window.KeyRex.onSuccess = function(xpub) {
            console.log('Key-Rex: Authentication successful! xpub:', xpub);
            // Show success notification
            const notification = document.createElement('div');
            notification.style.cssText = 'position: fixed; top: 20px; right: 20px; background: #10b981; color: white; padding: 16px 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); z-index: 10000; font-family: system-ui, -apple-system, sans-serif; font-size: 14px; display: flex; align-items: center; gap: 8px; animation: slideIn 0.3s ease-out;';
            notification.innerHTML = '<span style="font-size: 18px;">✓</span> <span>Authentication successful! Redirecting to dashboard...</span>';
            document.body.appendChild(notification);
            
            // Redirect to dashboard after a brief delay
            setTimeout(function() {
              window.location.href = 'dashboard.html?xpub=' + encodeURIComponent(xpub);
            }, 1500);
          };
          
          window.KeyRex.onError = function(error) {
            console.error('Key-Rex: Authentication error:', error);
            // Show error notification
            const notification = document.createElement('div');
            notification.style.cssText = 'position: fixed; top: 20px; right: 20px; background: #ef4444; color: white; padding: 16px 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); z-index: 10000; font-family: system-ui, -apple-system, sans-serif; font-size: 14px; display: flex; align-items: center; gap: 8px; animation: slideIn 0.3s ease-out;';
            notification.innerHTML = '<span style="font-size: 18px;">✗</span> <span>Authentication failed: ' + (error.message || error) + '</span>';
            document.body.appendChild(notification);
            
            // Auto-remove after 5 seconds
            setTimeout(function() {
              notification.style.animation = 'slideOut 0.3s ease-out';
              setTimeout(function() {
                if (notification.parentNode) {
                  notification.parentNode.removeChild(notification);
                }
              }, 300);
            }, 5000);
          };
          
          console.log('Key-Rex: Success and error callbacks set up');
        } else {
          // Retry if Key-Rex not ready yet
          setTimeout(setupKeyRexCallbacks, 500);
        }
      }
      
      // Add animation styles
      if (!document.getElementById('keyrex-notification-styles')) {
        const style = document.createElement('style');
        style.id = 'keyrex-notification-styles';
        style.textContent = '@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } } @keyframes slideOut { from { transform: translateX(0); opacity: 1; } to { transform: translateX(100%); opacity: 0; } }';
        document.head.appendChild(style);
      }
      
      // Set up callbacks when Key-Rex is ready
      setupKeyRexCallbacks();
      
      // Note: The embed script now automatically checks for xpub in URL params and calls onSuccess
      // So we don't need to manually check here - the onSuccess callback below will handle the redirect
    </script>
    
    <!-- Fallback: Static script tag in case dynamic loading fails -->
    <script>
      // Final fallback - if Key-Rex still doesn't exist after 6 seconds, try loading with static tag
      setTimeout(function() {
        if (typeof window.KeyRex === 'undefined') {
          console.warn('Key-Rex: Dynamic loading failed, trying static script tag fallback...');
          const fallbackScript = document.createElement('script');
          fallbackScript.src = 'http://localhost:3000/embed?siteId=a252dfa1030706a49efab31af2fc29d6&v=2';
          fallbackScript.async = true;
          fallbackScript.onload = function() {
            console.log('Key-Rex: Static fallback script loaded');
            setTimeout(function() {
              if (window.KeyRex && window.KeyRex.init) {
                console.log('Key-Rex: Calling init() from static fallback');
                window.KeyRex.init();
              }
            }, 500);
          };
          document.head.appendChild(fallbackScript);
        }
      }, 6000);
    </script>
  </body>
</html>


